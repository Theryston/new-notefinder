NODE_ENV=development
# WebSocket endpoint of the server process (ws://localhost:3334). 0 picks a
# free port.
PORT=3334

# The service's own Postgres: `nub run infra:up` starts it on port 5433
# (the API's Postgres uses 5432).
DATABASE_URL=postgres://music_catalog:music_catalog@localhost:5433/music_catalog

# Comma-separated API keys; a client sends one as `Authorization: Bearer <key>`
# in the WebSocket handshake. Each key is at least 32 characters. To rotate a
# key, list the new one next to the old one, move the clients, then drop the
# old one. Generate real ones with `openssl rand -base64 32`.
API_KEYS=local-dev-music-catalog-api-key-change-me

# `sample` restores MusicBrainz's small sample dump (development); `full`
# restores all of it (production). The choice is recorded by the first import.
CATALOG_DATASET=sample

# A connection that misses a pong for one whole interval is dropped.
HEARTBEAT_INTERVAL_MS=30000
# A request unanswered after this long gets an INTERNAL error.
REQUEST_TIMEOUT_MS=10000

# Meilisearch, the search engine: `nub run infra:up` starts it on port 7700
# (master key `local-dev-meilisearch-master-key`) and a job that creates the
# two keys below. Each process reads only its own: the server's key can only
# search and the worker's can manage the index and its documents. In
# production create them with the master key (see CLAUDE.md "Meilisearch").
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_SEARCH_API_KEY=121340fafb7e093b89f6a19190add33397ac663343cb4c9f76baff8ae1a5eb40
MEILISEARCH_WRITE_API_KEY=95695a2e89c1b56566c1e3d54b9e030dd033d42c3a3efe351b5f1c46fc839cb8

# Recordings the worker sends to Meilisearch per task while indexing: bigger
# batches index faster and use more memory, smaller ones checkpoint more often.
INDEXING_BATCH_SIZE=2000

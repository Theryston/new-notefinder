NODE_ENV=development
PORT=3333
# Comma-separated list of web origins allowed by CORS (with credentials).
WEB_ORIGINS=http://localhost:3000
# OpenAPI docs at /docs. Defaults to true outside production.
SWAGGER_ENABLED=true

# Not validated yet: used by the database module added later.
DATABASE_URL=postgres://notefinder:notefinder@localhost:5432/notefinder

# Redis for BullMQ queues, response cache and rate limiting.
REDIS_URL=redis://localhost:6379
# Express `trust proxy` (sets which proxies may report the client IP via
# X-Forwarded-For, which rate limiting keys on): a hop count, true/false, or a
# comma-separated list of addresses/subnets. The default trusts only private
# networks (e.g. the Coolify/Traefik container network). With a CDN in front,
# use the number of proxies between the client and the app (e.g. 2).
TRUST_PROXY=loopback, linklocal, uniquelocal
# Global rate limit per client IP: RATE_LIMIT_MAX requests per window.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# Base URL of the web app, used to call its cache revalidation endpoint.
WEB_URL=http://localhost:3000
# Same value as the web app's REVALIDATE_SECRET (min 32 chars, random in
# prod). Required in production; when unset elsewhere, revalidation jobs are
# logged and skipped.
REVALIDATE_SECRET=local-dev-revalidate-secret-change-me

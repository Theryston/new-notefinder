{
  "openapi": "3.0.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "HealthController_check_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The API process is up."
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/v1/health/ready": {
      "get": {
        "operationId": "HealthController_ready_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Every dependency is reachable."
          },
          "503": {
            "description": "At least one dependency is unreachable (see `checks`)."
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/v1/artists/{id}": {
      "get": {
        "operationId": "ArtistsController_getArtist_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The artist header detail."
          },
          "404": {
            "description": "Unknown ID (`NOT_FOUND`), or a legacy ID with its new ID (`RESOURCE_MOVED`)."
          }
        },
        "tags": [
          "artists"
        ]
      }
    },
    "/v1/artists/{id}/tracks": {
      "get": {
        "operationId": "ArtistsController_getArtistTracks_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The artist's processed tracks, paginated."
          },
          "400": {
            "description": "The cursor or limit is bad."
          },
          "404": {
            "description": "Unknown ID (`NOT_FOUND`), or a legacy ID with its new ID (`RESOURCE_MOVED`)."
          }
        },
        "tags": [
          "artists"
        ]
      }
    },
    "/v1/search": {
      "get": {
        "operationId": "SearchController_search_v1",
        "parameters": [
          {
            "name": "query",
            "required": true,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 256,
              "type": "string"
            }
          },
          {
            "name": "scope",
            "required": false,
            "in": "query",
            "schema": {
              "default": "metadata",
              "type": "string",
              "enum": [
                "metadata",
                "lyrics"
              ]
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "maximum": 900,
              "default": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Catalog matches, best first."
          },
          "400": {
            "description": "The query, scope or paging is bad."
          },
          "429": {
            "description": "Per-IP search rate exceeded."
          },
          "503": {
            "description": "The Music catalog is down."
          },
          "504": {
            "description": "The Music catalog took too long."
          }
        },
        "tags": [
          "search"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "UsersController_getMe_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The signed-in user."
          },
          "401": {
            "description": "No valid session."
          }
        },
        "tags": [
          "users"
        ]
      },
      "patch": {
        "operationId": "UsersController_updateMe_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMeBodyDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The signed-in user, updated."
          },
          "400": {
            "description": "The Name is empty or too long, or the Avatar is over 5 MB or not a PNG, JPEG or WEBP image."
          },
          "401": {
            "description": "No valid session."
          },
          "403": {
            "description": "The user has no username yet."
          }
        },
        "tags": [
          "users"
        ]
      }
    },
    "/v1/me/username": {
      "put": {
        "operationId": "UsersController_setUsername_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetUsernameBodyDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The user, with the username set."
          },
          "400": {
            "description": "The username is not valid."
          },
          "401": {
            "description": "No valid session."
          },
          "409": {
            "description": "The user already has a username, or another user has it."
          }
        },
        "tags": [
          "users"
        ]
      }
    }
  },
  "info": {
    "title": "notefinder API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "UpdateMeBodyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "avatar": {
            "type": "string",
            "format": "binary",
            "contentEncoding": "binary",
            "maxLength": 5242880
          }
        },
        "required": [
          "name"
        ]
      },
      "SetUsernameBodyDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        },
        "required": [
          "username"
        ]
      }
    }
  }
}

    "/v1/search": {
      "get": {
        "operationId": "SearchController_search_v1",
        "parameters": [
          {
            "name": "query",
            "required": true,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 256,
              "type": "string"
            }
          },
          {
            "name": "scope",
            "required": false,
            "in": "query",
            "schema": {
              "default": "metadata",
              "type": "string",
              "enum": [
                "metadata",
                "lyrics"
              ]
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "maximum": 900,
              "default": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Catalog matches, best first."
          },
          "400": {
            "description": "The query, scope or paging is bad."
          },
          "429": {
            "description": "Per-IP search rate exceeded."
          },
          "503": {
            "description": "The Music catalog is down."
          },
          "504": {
            "description": "The Music catalog took too long."
          }
        },
        "tags": [
          "search"
        ]
      }
    },

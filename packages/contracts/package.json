{
  "name": "@notefinder/contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth-rules": {
      "types": "./dist/auth-rules.d.ts",
      "default": "./dist/auth-rules.js"
    },
    "./avatar-rules": {
      "types": "./dist/avatar-rules.d.ts",
      "default": "./dist/avatar-rules.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "sideEffects": false
}

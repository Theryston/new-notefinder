{
  "name": "notefinder",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check-types": "turbo run check-types",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.11.4"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "0.9.5"
    }
  },
  "workspaces": [
    "apps/*"
  ],
  "allowScripts": {
    "unrs-resolver": true
  }
}
